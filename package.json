{
  "name": "2fa-authenticator",
  "version": "1.0.1",
  "description": "A desktop 2FA authenticator app for Windows",
  "license": "MIT",
  "author": {
    "name": "Pedro Fernandes",
    "email": "hello@impedro.com"
  },
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "dist": "npm run build && electron-builder --win nsis",
    "dist:linux": "npm run build && electron-builder --linux deb",
    "start": "electron-vite preview",
    "postinstall": "electron-builder install-app-deps"
  },
  "dependencies": {
    "@yudiel/react-qr-scanner": "^2.5.1",
    "electron-store": "^11.0.0",
    "otpauth": "^9.4.2",
    "jsqr": "^1.4.0",
    "lucide-react": "^0.468.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "electron-vite": "^2.3.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "vite": "^5.4.11"
  },
  "build": {
    "appId": "com.twofactor.authenticator",
    "productName": "2FA Authenticator",
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**/*",
      "package.json"
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        "nsis"
      ],
      "artifactName": "${productName}-${version}-Setup.${ext}"
    },
    "linux": {
      "icon": "build/icon.png",
      "target": [
        "deb"
      ],
      "artifactName": "${productName}-${version}-Setup.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}
